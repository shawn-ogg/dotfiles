{
  "title": "TESMART KVM Mac modifiers",
  "rules": [
    {
      "description": "Swap Alt and Command on TESMART keyboard",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_option"
          },
          "to": [
            {
              "key_code": "left_command"
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 3141,
                  "product_id": 29699,
                  "is_keyboard": true
                }
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "left_command"
          },
          "to": [
            {
              "key_code": "left_option"
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 3141,
                  "product_id": 29699,
                  "is_keyboard": true
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
